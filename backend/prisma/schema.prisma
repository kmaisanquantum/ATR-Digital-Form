datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// prisma {
//   "seed": "node prisma/seed.js"
// }

enum RequestStatus {
  REQUESTING_UNIT
  AMS
  SO3_AIR_PREP
  D_AIR
  COMD
  ADS
  APPROVED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   // 'Requesting Unit', 'AMS', 'SO3 Air Prep', 'D Air', 'COMD', 'ADS'
  createdAt DateTime @default(now())
}

model AtrRequest {
  id          String        @id @default(uuid())
  refNumber   String        @unique // Kept consistent with frontend generateRef()
  status      RequestStatus @default(REQUESTING_UNIT)
  formData    Json          // Captures complete collectFormData() object dynamically
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  signatures  Signature[]
}

model Signature {
  id           String     @id @default(uuid())
  atrRequestId String
  atrRequest   AtrRequest @relation(fields: [atrRequestId], references: [id], onDelete: Cascade)
  role         String     // Match stakeholder roles
  imageBlob    String     // Stores the base64 canvas string from SigPad
  signedBy     String
  signedAt     DateTime   @default(now())
}
